# Copy to .env and set published service tags, or run make latest-tags in the parent.
# Keep platform release selections here rather than in stack files or documentation.
DATABASE_BROKER_IMAGE_TAG=
ACCESS_GATEWAY_IMAGE_TAG=
FILES_IMAGE_TAG=
NOTES_IMAGE_TAG=

# Build and publish the independent razzie-cloud/landing image before selecting its tag.
LANDING_IMAGE_TAG=
# Optional JSON list; the deployment example includes Files and Notes.
LANDING_APPS_FILE=./landing-apps.json

# Inactive apps use fixed defaults; optional overrides are preserved by latest-tags.
RAZCHESS_IMAGE_TAG=v1.12
UUID_SERVER_IMAGE_TAG=v1.1
GEOIP_SERVER_IMAGE_TAG=v1.5
HUES_IMAGE_TAG=v1.5

# Operator-managed third-party image tags.
POSTGRES_IMAGE_TAG=17-alpine
# Valkey 9.1.0+ is required for numbered database ACLs.
VALKEY_IMAGE_TAG=9.1.0-alpine
WHOAMI_IMAGE_TAG=latest
DOZZLE_IMAGE_TAG=latest
CADDY_DOCKER_PROXY_IMAGE_TAG=2.8-alpine

# Public base hostname, without a scheme, port, or trailing slash.
# All service subdomains, auth settings, and homepage URLs follow this domain.
DOMAIN=razzie.cloud

DOCKER_CONTEXT=razcloud
# Client must provide docker stack config; optionally select a newer binary.
DOCKER_CLI=docker
STACK_NAME=razzie-cloud

# Temporary casting shares and delegated playback: positive duration, at most 24h.
CAST_SHARE_TTL=6h

# Notes users add S3 connections and optionally encrypted notebooks in the UI.
# These optional settings are operator egress exceptions, never credentials.
NOTES_S3_ALLOWED_PRIVATE_ENDPOINTS=
NOTES_S3_ALLOW_HTTP=false
NOTES_SCAN_INTERVAL=5m
NOTES_INDEX_WORKERS=4

# Scoped broker auth. none is an explicit legacy opt-out and needs no token/PKI resources.
BROKER_AUTH_MODE=token
BROKER_DEPLOYMENT_ID=razzie-cloud-production
BROKER_CLIENTS_FILE=./broker-clients.yml
BROKER_ORIGIN=https://database-broker:8443
# Run make broker-pki for an internal CA, or supply operator PKI with this SAN.
BROKER_CA_FILE=./pki/broker-ca.pem
BROKER_TLS_CERT_FILE=./pki/broker.pem
BROKER_TLS_KEY_SECRET=broker_tls_key
# Optional private CA key path for make broker-pki; defaults beside BROKER_CA_FILE.
BROKER_CA_KEY_FILE=
DEPLOY_TIMEOUT=300
# Publish images built with Dockerfile.broker-app, retaining upstream app layers.
# Defaults: ghcr.io/razzie-cloud/{razchess,geoip-server}-broker:$DATABASE_BROKER_IMAGE_TAG
RAZCHESS_BROKER_IMAGE=
GEOIP_SERVER_BROKER_IMAGE=
